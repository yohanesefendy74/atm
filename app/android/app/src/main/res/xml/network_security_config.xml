<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS ke server API kantor. Sertifikat dari CA internal perusahaan bisa dipasang di HP
     (Pengaturan > Keamanan > Install sertifikat) dan akan dipercaya oleh aplikasi ini.
     HTTP polos (cleartext) diblokir. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
